# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=talentlink_db

# JWT Configuration (generate with: openssl rand -base64 32)
JWT_SECRET=your_secure_32_chars_minimum_secret_key_here
JWT_EXPIRY_HOURS=8

# CORS Configuration (set to your domain in production)
CORS_ORIGIN=*

# Environment
APP_ENV=development
APP_DEBUG=true
LOG_PATH=logs/
